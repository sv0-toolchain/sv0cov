/* TEST-001 property layer (SPEC.md §16.2) and TEST-004: a fixed,
 * checked-in seed for pseudo-random sampling, so failures reproduce.
 *
 * One property per file. `ROUNDS` and the seed below are the recorded fuzz
 * budget: docs/fuzz.tsv pins both, and scripts/check_fuzz_budget.py fails CI
 * if either drifts or ROUNDS falls under its floor. The generator
 * (`next_u64`/`unit_f64`, lib/random.sv0) is a pure function of the seed:
 * no OS entropy, no clock, so a rerun gives bit-identical samples.
 */
use random::next_u64;
use random::unit_f64;
use arith::abs_f64;
use trig::pi_f64;
use trig::sin_f64;
use trig::cos_f64;

fn main() -> i32 {
    let ROUNDS: i32 = 30;
    let mut state: u64 = 88172645463325252;

    /* REQ: TRIG-001 property — sin_f64(x)^2 + cos_f64(x)^2 ~= 1.0, over
     * seeded samples spanning [-1000*pi, 1000*pi] (PERF-002's own
     * domain). */
    let mut i: i32 = 0;
    while i < ROUNDS loop_invariant(i <= ROUNDS) {
        state = next_u64(state);
        let u: f64 = unit_f64(state);
        let x: f64 = (u - 0.5) * 2000.0 * pi_f64();
        let s: f64 = sin_f64(x);
        let c: f64 = cos_f64(x);
        let sum: f64 = s * s + c * c;
        if abs_f64(sum - 1.0) >= 0.0000001 { return 1; }
        i = i + 1;
    }
    return 0;
}
