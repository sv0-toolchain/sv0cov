# Scoped here, not at the root: hatchling force-includes a root .gitignore
# in every sdist, which the explicit sdist allowlist forbids.
__pycache__/
*.pyc
# The release build-info resource is generated by tools/release.py before a
# release build and must never be tracked (SPEC 25.2.7.1).
sv0cov/_build_info.json
