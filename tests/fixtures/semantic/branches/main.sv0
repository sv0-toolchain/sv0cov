/* sv0cov R0 fixture (CV-028): if true-only, false-only, both, else, nested, early returns. */

fn sign(n: i32) -> i32 {
  if n < 0 {
    return 0 - 1;
  } else {
    if n == 0 {
      return 0;
    };
  };
  return 1;
}

fn clamp(n: i32) -> i32 {
  let mut r = n;
  if r > 100 {
    r = 100;
  };
  return r;
}

fn magnitude(n: i32) -> i32 {
  if n < 0 {
    return 0 - n;
  };
  return n;
}

fn main() -> i32 {
  let a = sign(5);
  let b = sign(0);
  let c = clamp(7);
  let d = magnitude(0 - 3);
  return a + b + c + d - 11;
}
