{"$comment":"sv0cov.baseline 1.0 (SPEC 22.4; CV-313): the digest-pinned summary a ratchet compares with. baseline_sha256 is the SHA-256 of the canonical bytes of the object without it. Order, lexical forms, the pin and covered <= total are semantic checks (sv0cov.formats.baseline).","$defs":{"baseline":{"additionalProperties":false,"properties":{"baseline_sha256":{"$ref":"sv0cov.map-1.0.schema.json#/$defs/digest"},"commit":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/commit"}]},"exclusion_records":{"$ref":"sv0cov.indexed-semantic-1.0.schema.json#/$defs/count"},"metric_schema":{"description":"The metric schema the counts were made under, e.g. \"sv0cov.report 1.0\" (printable ASCII, checked semantically).","maxLength":64,"minLength":1,"type":"string"},"metrics":{"additionalProperties":false,"properties":{"branch":{"$ref":"#/$defs/metric_counts"},"contract":{"$ref":"#/$defs/metric_counts"},"function":{"$ref":"#/$defs/metric_counts"},"line":{"$ref":"#/$defs/metric_counts"},"region":{"$ref":"#/$defs/metric_counts"}},"required":["branch","contract","function","line","region"],"type":"object"},"saturation_policy":{"enum":["allow-ordinary","fail"]},"schema":{"const":"sv0cov.baseline"},"sources":{"items":{"$ref":"#/$defs/source"},"type":"array"},"tool":{"additionalProperties":false,"properties":{"name":{"const":"sv0cov"},"version":{"maxLength":128,"minLength":1,"type":"string"}},"required":["name","version"],"type":"object"},"version":{"const":"1.0"}},"required":["baseline_sha256","commit","exclusion_records","metric_schema","metrics","saturation_policy","schema","sources","tool","version"],"type":"object"},"commit":{"description":"A Git object name: 40 or 64 lowercase hex digits (checked semantically).","maxLength":64,"minLength":40,"type":"string"},"metric_counts":{"additionalProperties":false,"properties":{"covered":{"$ref":"sv0cov.indexed-semantic-1.0.schema.json#/$defs/count"},"excluded":{"$ref":"sv0cov.indexed-semantic-1.0.schema.json#/$defs/count"},"total":{"$ref":"sv0cov.indexed-semantic-1.0.schema.json#/$defs/count"}},"required":["covered","excluded","total"],"type":"object"},"source":{"additionalProperties":false,"properties":{"digest":{"$ref":"sv0cov.map-1.0.schema.json#/$defs/digest"},"path":{"$ref":"sv0cov.map-1.0.schema.json#/$defs/logical_path"}},"required":["digest","path"],"type":"object"}},"$ref":"#/$defs/baseline","$schema":"https://json-schema.org/draft/2020-12/schema"}
